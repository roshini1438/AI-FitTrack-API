{
  "info": {
    "name": "FitTrack AI",
    "description": "REST API collection for the FitTrack AI backend (Auth, Workouts, AI).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "workoutId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul\",\n  \"email\": \"rahul@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/profile"
          }
        }
      ]
    },
    {
      "name": "Workouts",
      "item": [
        {
          "name": "Add Workout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/workouts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workoutName\": \"Morning Running\",\n  \"category\": \"Cardio\",\n  \"duration\": 30,\n  \"caloriesBurned\": 250,\n  \"workoutDate\": \"2026-09-24\"\n}"
            }
          }
        },
        {
          "name": "Get All Workouts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/workouts"
          }
        },
        {
          "name": "Search Workouts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/workouts/search?category=Cardio"
          }
        },
        {
          "name": "Get Workout By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/workouts/{{workoutId}}"
          }
        },
        {
          "name": "Update Workout",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/workouts/{{workoutId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"duration\": 40\n}"
            }
          }
        },
        {
          "name": "Delete Workout",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/workouts/{{workoutId}}"
          }
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Workout Recommendation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/ai/recommendation",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 25,\n  \"fitnessGoal\": \"Muscle Gain\",\n  \"experienceLevel\": \"Beginner\"\n}"
            }
          }
        },
        {
          "name": "Fitness Insights",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/ai/insights"
          }
        }
      ]
    }
  ]
}
